# /etc/fodek-monitor.env
# Copy to /etc/fodek-monitor.env on the server and fill in. The systemd
# service loads this file. Do NOT commit the real (filled-in) version.

# Containers to watch. Leave blank to auto-watch ALL containers on the host.
# CONTAINERS="fodek-api fodek-web postgres redis"
CONTAINERS=""

# Public endpoints to probe (502/5xx/timeout = down).
ENDPOINTS="https://uat-api.fodek.net/ https://flod.uat.fodek.net/"

# Auto-restart a down container before alerting.
AUTO_RECOVER="true"

# ---- Alerting: choose ONE ----
# NOTIFY_METHOD = telegram | webhook | email | none
NOTIFY_METHOD="telegram"

# Telegram: create a bot with @BotFather, get the token; get your chat id from
# @userinfobot (or https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot).
TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
TELEGRAM_CHAT_ID="111111111"

# Discord/Slack incoming webhook (used when NOTIFY_METHOD=webhook)
WEBHOOK_URL=""

# Email recipient (used when NOTIFY_METHOD=email; needs working `mail`/msmtp)
EMAIL_TO=""

HOSTNAME_LABEL="fodek-uat"
